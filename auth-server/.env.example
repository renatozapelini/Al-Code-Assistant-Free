# Configuração do servidor de autenticação
PORT=3001

# Chave secreta para JWT (gere uma string aleatória longa)
JWT_SECRET=sua-chave-secreta-super-segura-aqui

# Credenciais do administrador padrão
ADMIN_EMAIL=admin@codeassistants.local
ADMIN_PASSWORD=CodeAssistantsAdmin2026!

# CORS - URL do seu frontend (ex: https://seu-app.vercel.app)
# Deixe vazio ou * para permitir todos (apenas desenvolvimento)
CORS_ORIGIN=https://seu-frontend.vercel.app
